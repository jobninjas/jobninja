generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  connectors Connector[]
  candidates Candidate[]
  workflows  Workflow[]
  roles      Role[]
  agentRuns  AgentRun[]
  boards     Board[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Connector {
  id             String       @id @default(uuid())
  organizationId String
  provider       String       // e.g., "GREENHOUSE", "WORKDAY", "LEVER"
  accessToken    String?
  refreshToken   String?
  webhookId      String?
  status         String       @default("ACTIVE")
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  department     String
  location       String
  hiringManager  String
  jobDescription String
  status         String       @default("open")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  candidates     Candidate[]
  interviews     Interview[]
  agentRuns      AgentRun[]
  agentEvents    AgentEvent[]
  boards         Board[]
}

model Candidate {
  id             String       @id @default(uuid())
  organizationId String
  roleId         String
  atsId          String?      // Optional since we're creating locally
  firstName      String
  lastName       String
  email          String
  location       String?
  resumeUrl      String?
  resumeText     String?
  linkedinUrl    String?
  stage          String       @default("APPLIED") // APPLIED, RECRUITER_SCREEN, SHORTLISTED, ONSITE, FINAL, HIRED, REJECTED
  
  travelBudget   Float?

  // Agentic Signals (Legacy/Convenience)
  fraudScore     Float?
  technicalScore Float?
  cultureScore   Float?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  agentRuns      AgentRun[]
  resumes        Resume[]
  interviews     Interview[]
  artifacts      AgentArtifact[]
  events         AgentEvent[]
  stageHistory   CandidateStageHistory[]
}

model Resume {
  id             String       @id @default(uuid())
  candidateId    String
  fileUrl        String?
  parsedText     String?
  extractedSkills Json?
  createdAt      DateTime     @default(now())

  candidate      Candidate    @relation(fields: [candidateId], references: [id])
}

model Interview {
  id                  String       @id @default(uuid())
  candidateId         String
  roleId              String
  round               String
  type                String
  scheduledAt         DateTime?
  transcriptUrl       String?
  transcriptText      String?
  interviewerFeedback String?
  status              String       @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  candidate           Candidate    @relation(fields: [candidateId], references: [id])
  role                Role         @relation(fields: [roleId], references: [id])
}

model Workflow {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  nodesJson      Json         // UI layout definition for visual builder
  edgesJson      Json         
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Board {
  id             String       @id @default(uuid())
  organizationId String
  roleId         String       @unique
  layers         Json
  layerIds       Json
  edges          Json
  edgeIds        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
}

model AgentRun {
  id             String       @id @default(uuid())
  organizationId String
  roleId         String
  candidateId    String
  nodeId         String?      // Links back to the canvas node
  agentType      String       // "RESUME_INTELLIGENCE", "INTERVIEW_PLANNING", etc.
  status         String       // "QUEUED", "RUNNING", "SUCCESS", "ERROR"
  inputPayload   Json?
  outputPayload  Json?
  errorDetails   String?
  startedAt      DateTime?
  completedAt    DateTime?
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  candidate      Candidate    @relation(fields: [candidateId], references: [id])
  artifacts      AgentArtifact[]
  events         AgentEvent[]
}

model AgentArtifact {
  id             String       @id @default(uuid())
  agentRunId     String
  candidateId    String
  artifactType   String       // e.g., "ResumeAnalysis", "InterviewPlan"
  data           Json
  createdAt      DateTime     @default(now())

  agentRun       AgentRun     @relation(fields: [agentRunId], references: [id])
  candidate      Candidate    @relation(fields: [candidateId], references: [id])
}

model AgentEvent {
  id             String       @id @default(uuid())
  eventType      String       // e.g., "candidate.shortlisted", "resume.analysis_completed"
  roleId         String
  candidateId    String
  agentRunId     String?
  payload        Json?
  createdAt      DateTime     @default(now())

  role           Role         @relation(fields: [roleId], references: [id])
  candidate      Candidate    @relation(fields: [candidateId], references: [id])
  agentRun       AgentRun?    @relation(fields: [agentRunId], references: [id])
}

model CandidateStageHistory {
  id             String       @id @default(uuid())
  candidateId    String
  fromStage      String
  toStage        String
  reason         String?
  changedBy      String?      // Could be User ID or "SYSTEM"/"AGENT"
  createdAt      DateTime     @default(now())

  candidate      Candidate    @relation(fields: [candidateId], references: [id])
}
